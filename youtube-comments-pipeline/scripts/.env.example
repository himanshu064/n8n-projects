# Reference IDs and keys the workflow uses.
# These live in n8n Credentials (encrypted) — this file only documents the shape.
# Copy to .env, fill in your own values, and NEVER commit the real .env.

# YouTube Data API v3 — passed as the `key` query param on the two YouTube nodes
YOUTUBE_API_KEY_V3=

# Anthropic (Claude) — stored in n8n as a Header Auth credential: x-api-key = this value
CLAUDE_API_KEY=

# Google Drive folder that the report Docs are created in
GOOGLE_DRIVE_FOLDER_ID=

# Google Sheet used as the run history / log
GOOGLE_SHEET_ID=

# Slack bot token (xoxb-…) for the "Post to Slack" node
SLACK_BOT_TOKEN=
